# Daylight — example environment / secrets.
# Copy values into Cloudflare Worker secrets/vars. Never commit real keys.

# Google OAuth (Worker)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_KEY=
ALLOWED_ORIGINS=https://kratveer.github.io,http://localhost:8000
ALLOWED_EMAILS=

# Gemini intelligence (Worker secrets / vars)
# Create a key at https://aistudio.google.com/apikey — keep it server-side only.
GEMINI_API_KEY=
# Free-tier friendly default; change if Google renames models.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_PER_HOUR=40
